NODE_ENV=development
PORT=3333
WEB_ORIGIN=http://localhost:3000

# Postgres local (docker-compose up -d db). Em produção: string do Supabase.
DATABASE_URL=postgresql://hermes:hermes@localhost:5432/hermes?schema=public

# Segredos JWT (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_ACCESS_SECRET=troque-por-um-segredo-de-32-bytes
JWT_REFRESH_SECRET=troque-por-outro-segredo-de-32-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Usado apenas pelo seed (prisma db seed) para criar o admin inicial
ADMIN_EMAIL=admin@hermesmarmitaria.com
ADMIN_PASSWORD=troque-esta-senha
ADMIN_NOME=Administrador
